{
  "manifestVersion": 2,
  "id": "pi-durable",
  "name": "Pi Durable",
  "version": "0.1.1",
  "license": "MIT",
  "repository": "https://github.com/gvillarroel/orca-plugins",
  "description": "Recluta y configura agentes de Pi Durable, conversa con ellos y recupera el historial desde Orca.",
  "engines": { "orca": ">=1.4.278" },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "worker.mjs",
  "capabilities": [{ "kind": "settings:own" }, { "kind": "storage:own" }],
  "contributes": {
    "panels": [
      { "id": "agents", "title": "Pi Durable", "icon": "bot", "entry": "panel.html", "ui": "html" }
    ],
    "settings": [
      {
        "key": "connectionsFile",
        "title": "Registro externo",
        "description": "Ruta absoluta al archivo JSON con las conexiones de tus agentes externos.",
        "type": "string",
        "default": ""
      }
    ]
  }
}
